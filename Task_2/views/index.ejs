<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Task 2: Inline Styles & Validation</title>
</head>
<body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background-color: #f4f6f8; margin: 0; padding: 30px;">

  <div style="max-width: 650px; margin: 0 auto; background: #ffffff; padding: 25px; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.06); border: 1px solid #e1e4e8;">
    <h2 style="margin-top: 0; color: #1e293b; border-bottom: 2px solid #0284c7; padding-bottom: 10px;">Level 1 - Task 2: Validation Form</h2>

    <!-- Error Banner -->
    <div id="clientError" style="display: none; background-color: #fee2e2; border-left: 4px solid #ef4444; color: #991b1b; padding: 12px; margin-bottom: 15px; border-radius: 4px; font-size: 14px;"></div>
    <% if (errorMessage) { %>
      <div style="background-color: #fee2e2; border-left: 4px solid #ef4444; color: #991b1b; padding: 12px; margin-bottom: 15px; border-radius: 4px; font-size: 14px;">
        <%= errorMessage %>
      </div>
    <% } %>

    <!-- Form with Inline JS Validation -->
    <form action="/submit" method="POST" onsubmit="return validateClientForm()">
      <div style="margin-bottom: 15px;">
        <label style="display: block; font-weight: 600; margin-bottom: 6px; color: #334155;">Full Name:</label>
        <input type="text" id="username" name="username" value="<%= formData.username || '' %>" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box;">
      </div>

      <div style="margin-bottom: 15px;">
        <label style="display: block; font-weight: 600; margin-bottom: 6px; color: #334155;">Email Address:</label>
        <input type="text" id="email" name="email" value="<%= formData.email || '' %>" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box;">
      </div>

      <div style="display: flex; gap: 15px; margin-bottom: 15px;">
        <div style="flex: 1;">
          <label style="display: block; font-weight: 600; margin-bottom: 6px; color: #334155;">Age (18-100):</label>
          <input type="number" id="age" name="age" value="<%= formData.age || '' %>" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box;">
        </div>
        <div style="flex: 1;">
          <label style="display: block; font-weight: 600; margin-bottom: 6px; color: #334155;">Phone (10 Digits):</label>
          <input type="text" id="phone" name="phone" value="<%= formData.phone || '' %>" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box;">
        </div>
      </div>

      <button type="submit" style="background-color: #0284c7; color: white; border: none; padding: 10px 20px; font-weight: 600; border-radius: 4px; cursor: pointer;">
        Validate & Save Record
      </button>
    </form>

    <hr style="border: none; border-top: 1px solid #e2e8f0; margin: 30px 0;">

    <!-- Server Storage Display -->
    <h3 style="color: #1e293b; margin-bottom: 12px;">Temporary Server Storage (<%= records.length %> records)</h3>
    <% if (records.length === 0) { %>
      <p style="color: #64748b; font-style: italic;">No records in memory yet. Submit the form above.</p>
    <% } else { %>
      <table style="width: 100%; border-collapse: collapse; margin-top: 10px; text-align: left; font-size: 14px;">
        <thead>
          <tr style="background-color: #f8fafc; border-bottom: 2px solid #e2e8f0;">
            <th style="padding: 8px;">ID</th>
            <th style="padding: 8px;">Name</th>
            <th style="padding: 8px;">Email</th>
            <th style="padding: 8px;">Age</th>
            <th style="padding: 8px;">Phone</th>
            <th style="padding: 8px;">Timestamp</th>
          </tr>
        </thead>
        <tbody>
          <% records.forEach(record => { %>
            <tr style="border-bottom: 1px solid #f1f5f9;">
              <td style="padding: 8px;"><%= record.id %></td>
              <td style="padding: 8px; font-weight: 500;"><%= record.username %></td>
              <td style="padding: 8px;"><%= record.email %></td>
              <td style="padding: 8px;"><%= record.age %></td>
              <td style="padding: 8px;"><%= record.phone %></td>
              <td style="padding: 8px; color: #64748b;"><%= record.createdAt %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>

  <script>
    function validateClientForm() {
      const name = document.getElementById("username").value.trim();
      const email = document.getElementById("email").value.trim();
      const age = parseInt(document.getElementById("age").value);
      const phone = document.getElementById("phone").value.trim();
      const errorDiv = document.getElementById("clientError");

      const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      const phonePattern = /^[0-9]{10}$/;

      let message = "";
      if (name.length < 3) {
        message = "Client Validation: Name must be at least 3 characters.";
      } else if (!emailPattern.test(email)) {
        message = "Client Validation: Invalid email address format.";
      } else if (isNaN(age) || age < 18 || age > 100) {
        message = "Client Validation: Age must be a number between 18 and 100.";
      } else if (!phonePattern.test(phone)) {
        message = "Client Validation: Phone number must be exactly 10 digits.";
      }

      if (message !== "") {
        errorDiv.textContent = message;
        errorDiv.style.display = "block";
        return false;
      }

      errorDiv.style.display = "none";
      return true;
    }
  </script>
</body>
</html>
